<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Case Studies | PAARU STUDIO</title>
    <link rel="stylesheet" href="styles.css">
    <link rel="stylesheet" href="popup-form.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap"
        rel="stylesheet">
</head>

<body class="services-page">
    <!-- Top Banner -->
    <div class="top-banner">
        <div class="container">
            <div class="banner-content">
                <p>Let's Create Your Success Story</p>
                <a href="get-started.html" class="book-now-btn">Get Started</a>
            </div>
        </div>
    </div>

    <!-- Navigation -->
    <nav class="navbar">
        <div class="container">
            <div class="nav-content">
                <a href="index.html" class="logo">
                    <img loading="lazy" src="logo.png" alt="Paaru Studio Logo" class="logo-image">
                    <span class="logo-text">
                        <span class="logo-text-static">PAARU</span>
                        <span class="logo-text-flip">
                            <span class="flip-word">STUDIO</span>
                            <span class="flip-word">MEDIA</span>
                        </span>
                    </span>
                </a>
                <!-- Mobile menu button (visible on small screens) -->
                <button class="mobile-menu-btn" aria-label="Open menu" aria-expanded="false">☰</button>
                <div class="nav-links">
                    <a href="index.html">Home</a>
                    <a href="services.html">Services</a>
                    <a href="ecommerce.html">E-Commerce</a>
                    <div class="nav-dropdown">
                        <a href="media-offerings.html" class="nav-dropdown-toggle">Media <span
                                class="dropdown-arrow">▾</span></a>
                        <div class="nav-dropdown-menu">
                            <a href="media-offerings.html">Media Offerings (OOH & DOOH)</a>
                            <a href="performance-marketing.html">Performance Marketing</a>
                            <a href="social-media-marketing.html">Social Media Marketing</a>
                            <a href="influencer-marketing.html">Influencer Marketing</a>
                        </div>
                    </div>
                    <a href="portfolio.html">Portfolio</a>
                    <a href="get-started.html">Get Started</a>
                    <a href="join-team.html">Join Team</a>
                    <a href="index.html#contact" class="cta-btn">Contact Us</a>
                </div>
            </div>
        </div>
    </nav>
    <div class="mobile-nav-backdrop" aria-hidden="true"></div>

    <!-- Page Header -->
    <section class="page-hero">
        <div class="container">
            <h1 class="page-title">CASE <span class="gradient-text">STUDIES</span></h1>
            <p class="page-subtitle">Real Results, Real Impact - Discover How We've Helped Brands Achieve Their Goals
            </p>
        </div>
    </section>

    <!-- Case Studies Grid -->
    <section class="case-studies-section">
        <div class="container">
            <div class="case-studies-grid">
                <!-- Japfa Case Study -->
                <div class="case-study-card">
                    <a href="case-study-japfa.html" class="case-study-link">
                        <div class="case-study-image">
                            <img loading="lazy" src="japfa_hero.png" alt="Japfa Case Study">
                            <div class="case-study-overlay">
                                <span class="view-case-study">View Case Study →</span>
                            </div>
                        </div>
                        <div class="case-study-content">
                            <h3 class="case-study-title">Japfa</h3>
                            <p class="case-study-description">Performance marketing campaign driving measurable results
                                for Indonesia's leading agribusiness company.</p>
                            <div class="case-study-tags">
                                <span class="tag">Performance Marketing</span>
                                <span class="tag">Digital Strategy</span>
                            </div>
                        </div>
                    </a>
                </div>

                <!-- Calvin Klein Case Study -->
                <div class="case-study-card">
                    <a href="case-study-calvin-klein.html" class="case-study-link">
                        <div class="case-study-image">
                            <img loading="lazy" src="ck-banner.png" alt="Calvin Klein Case Study">
                            <div class="case-study-overlay">
                                <span class="view-case-study">View Case Study →</span>
                            </div>
                        </div>
                        <div class="case-study-content">
                            <h3 class="case-study-title">Calvin Klein</h3>
                            <p class="case-study-description">Creative campaign showcasing bold visual storytelling and
                                innovative brand positioning for luxury fashion.</p>
                            <div class="case-study-tags">
                                <span class="tag">Creative Design</span>
                                <span class="tag">Brand Campaign</span>
                            </div>
                        </div>
                    </a>
                </div>

                <!-- GIVA Case Study -->
                <div class="case-study-card">
                    <a href="case-study-giva.html" class="case-study-link">
                        <div class="case-study-image">
                            <img loading="lazy" src="giva-banner.png" alt="GIVA Case Study">
                            <div class="case-study-overlay">
                                <span class="view-case-study">View Case Study →</span>
                            </div>
                        </div>
                        <div class="case-study-content">
                            <h3 class="case-study-title">GIVA</h3>
                            <p class="case-study-description">E-commerce jewelry brand growth through comprehensive
                                digital marketing and content creation.</p>
                            <div class="case-study-tags">
                                <span class="tag">E-Commerce</span>
                                <span class="tag">Content Creation</span>
                            </div>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section class="cta-section" style="padding: 80px 0; background: var(--secondary-bg);">
        <div class="container" style="text-align: center;">
            <h2 style="font-size: 42px; margin-bottom: 20px; color: var(--text-primary);">Ready to Create Your <span
                    class="gradient-text">Success Story</span>?</h2>
            <p
                style="font-size: 18px; color: var(--text-secondary); margin-bottom: 40px; max-width: 700px; margin-left: auto; margin-right: auto;">
                Let's discuss how we can help your brand achieve remarkable results through data-driven strategies and
                creative excellence.</p>
            <a href="get-started.html" class="cta-btn large">START YOUR PROJECT</a>
        </div>
    </section>

    <!-- Footer -->
    <footer class="footer full-bleed">
        <div class="footer-cta">
            <div class="container">
                <h2>Looking to drive results? <a href="get-started.html" class="footer-cta-link">Let's chat →</a></h2>
            </div>
        </div>
        <div class="footer-main">
            <div class="container">
                <div class="footer-grid">
                    <div class="footer-brand">
                        <h3>PAARU STUDIO</h3>
                        <p>An Agency of Possibilities</p>
                        <div class="footer-social">
                            <a href="https://www.linkedin.com/company/paaru-studio/?viewAsMember=true" target="_blank"
                                rel="noopener noreferrer" aria-label="Instagram">Instagram</a>
                            <a href="https://www.linkedin.com/company/paaru-studio" target="_blank"
                                rel="noopener noreferrer" aria-label="LinkedIn">LinkedIn</a>
                            <a href="#" aria-label="Facebook">Facebook</a>
                        </div>
                    </div>
                    <div class="footer-nav">
                        <div class="footer-col">
                            <h4>Services</h4>
                            <a href="services.html">All Services</a>
                            <a href="media-offerings.html">Media Offerings</a>
                            <a href="ecommerce.html">E-Commerce</a>
                            <a href="portfolio.html">Portfolio</a>
                        </div>
                        <div class="footer-col">
                            <h4>Company</h4>
                            <a href="index.html">Home</a>
                            <a href="portfolio.html">Portfolio</a>
                            <a href="case-studies.html">Case Studies</a>
                            <a href="join-team.html">Join Team</a>
                            <a href="index.html#contact">Contact</a>
                        </div>
                        <div class="footer-col">
                            <h4>Legal</h4>
                            <a href="#">Security Compliance</a>
                            <a href="#">Accessibility</a>
                            <a href="#">Terms of Use</a>
                            <a href="privacy-policy.html">Privacy Policy</a>
                        </div>
                    </div>
                </div>
                <div class="footer-bottom">
                    <p>&copy; 2025 Paaru Studio. All rights reserved.</p>
                    <div class="footer-meta">
                        <a href="#top" class="back-to-top">↑</a>
                    </div>
                </div>
            </div>
        </div>
    </footer>

