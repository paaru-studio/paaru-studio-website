RewriteEngine On

# 1. Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2. Force non-www (https://paarustudio.com/)
RewriteCond %{HTTP_HOST} ^www\.paarustudio\.com [NC]
RewriteRule ^(.*)$ https://paarustudio.com/$1 [L,R=301]

# 3. Redirect index.html to Root (Avoid Duplicate Content)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html\ HTTP/
RewriteRule ^index\.html$ https://paarustudio.com/ [R=301,L]

# 4. Redirect services.html directly to clean URL video-production
RewriteRule ^services\.html$ https://paarustudio.com/video-production [R=301,L]

# 5. Redirect external requests for *.html to clean extensionless URLs (avoids duplicates)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^\.]+)\.html\ HTTP/
RewriteRule ^([^\.]+)\.html$ https://paarustudio.com/$1 [R=301,L]

# 6. Internally route clean extensionless URLs to their physical .html files
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.*?)/?$ $1.html [L]

# Browser Caching
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresDefault "access plus 2 days"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(ico|pdf|flv|jpg|jpeg|png|gif|js|css|swf|webp)$">
        Header set Cache-Control "max-age=31536000, public"
    </FilesMatch>
</IfModule>
