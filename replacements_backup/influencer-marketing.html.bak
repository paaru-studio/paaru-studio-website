    <!-- Introduction Section with Image -->
    <section class="about-section im-intro">
        <div class="container">
            <!-- Image and Text Layout -->
            <div class="ecommerce-detail">
                <div class="ecommerce-copy">
                    <h2>Strategic Influencer Marketing That <span class="gradient-text">Drives Results</span></h2>
                    <p class="large-text">At Paaru Studio, we are a full-stack influencer marketing agency that puts
                        data and creativity to work. We understand the pulse of platforms like Instagram, YouTube,
                        TikTok, LinkedIn, and Twitter.</p>
                    <p>We manage every step of influencer collaboration—from discovery and outreach to content creation
                        and performance tracking. Whether you're looking to partner with micro-influencers, nano
                        influencers, or celebrity influencers, we match your brand with the right voices to maximize
                        engagement, credibility, and ROI.</p>
                    <p>From viral Instagram reels to compelling YouTube content, our influencer marketing services
                        transform brand messages into relatable stories that resonate with communities, drive
                        conversions, and build lasting brand loyalty.</p>
                </div>
                <div class="ecommerce-image">
                    <img src="im_1.jpg" alt="Influencer Marketing Services">
                </div>
            </div>
            <div class="im-cta-container">
                <a href="portfolio.html" class="cta-btn">View Portfolio</a>
            </div>
        </div>
