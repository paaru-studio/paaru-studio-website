                    <div class="service-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                            <circle cx="9" cy="7" r="4"></circle>
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                        </svg>
                    </div>
                    <h3>Micro & Nano Campaigns</h3>
                    <p>We specialize in micro and nano influencer campaigns that deliver highly engaged niche audiences
                        with authentic connections at a fraction of celebrity partnership costs.</p>
                </div>

                <div class="service-item">
                    <div class="service-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                            <polygon
                                points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2">
                            </polygon>
                        </svg>
                    </div>
                    <h3>Celebrity Management</h3>
                    <p>For maximum reach and brand prestige, we facilitate celebrity influencer partnerships. From
                        contract negotiation to campaign execution, we manage every detail.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Influencer Network Form -->
    <section class="influencer-section">
        <div class="container">
            <div class="influencer-content">
                <div class="influencer-text">
                    <!-- Influencer network image inserted by request -->
                    <div class="im-network-image">
                        <img src="https://res.cloudinary.com/dvjveceob/image/upload/v1764927530/paaru-studio/Influencer%20Network%20Pic.png" alt="Influencer Network" class="influencer-image">
                    </div>
                    <h2>Join Our Influencer Network</h2>
                    <p>Are you an influencer looking to collaborate with brands? Join our network and get access to
                        exclusive campaigns and opportunities.</p>
                    <ul class="benefits-list">
                        <li>✓ Exclusive Brand Collaborations</li>
                        <li>✓ Competitive Compensation</li>
                        <li>✓ Professional Support</li>
                        <li>✓ Creative Freedom</li>
                    </ul>
                </div>
                <div class="influencer-form">

                    <div class="form-wrapper">
                        <form id="signupForm" action="https://formspree.io/f/mblzqbjr" method="POST" novalidate>
                            <h3>Sign Up Now</h3>

                            <div class="grid">
                                <div>
                                    <label for="fullName">Full Name</label>
                                    <input type="text" id="fullName" name="Full Name" placeholder="Full name" required>
                                    <span class="error" id="nameError">Please enter your full name.</span>
                                </div>

                                <div>
                                    <label for="email">Email</label>
                                    <input type="email" id="email" name="Email" placeholder="you@example.com" required>
                                    <span class="error" id="emailError">Please enter a valid email address.</span>
                                </div>

                                <div>
                                    <label for="phone">Phone</label>
                                    <input type="tel" id="phone" name="Phone Number" placeholder="Phone"
                                        pattern="[0-9]{10,15}" required>
                                    <span class="error" id="phoneError">Please enter a valid phone number.</span>
                                </div>

                                <div>
                                    <label for="gender">Gender</label>
                                    <select id="gender" name="Gender" required>
                                        <option value="">Select</option>
                                        <option>Female</option>
                                        <option>Male</option>
                                        <option>Non-binary</option>
                                        <option>Prefer not to say</option>
                                    </select>
                                    <span class="error" id="genderError">Please select your gender.</span>
                                </div>

                                <div>
                                    <label for="platform">Platform</label>
                                    <select id="platform" name="Platform" required>
                                        <option value="">Select</option>
                                        <option>Instagram</option>
                                        <option>Facebook</option>
                                        <option>Twitter (X)</option>
                                        <option>LinkedIn</option>
                                        <option>Snapchat</option>
                                        <option>YouTube</option>
                                        <option>Other</option>
                                    </select>
                                    <span class="error" id="platformError">Please select a platform.</span>
                                </div>

                                <div>
                                    <label for="profile">Profile Link</label>
                                    <input type="url" id="profile" name="Profile Link" placeholder="https://" required>
                                    <span class="error" id="profileError">Please enter a valid profile URL.</span>
                                </div>

                                <div>
                                    <label for="followers">Followers</label>
                                    <input type="number" id="followers" name="Followers Count" placeholder="e.g. 12000"
                                        min="1" required>
                                    <span class="error" id="followersError">Please enter a valid follower count.</span>
                                </div>

                                <div>
                                    <label for="state">State</label>
                                    <input type="text" id="state" name="State" placeholder="State" required>
                                    <span class="error" id="stateError">Please enter your state.</span>
                                </div>

                                <div>
                                    <label for="category">Category</label>
                                    <input type="text" id="category" name="Category" placeholder="e.g. Fashion, Food"
                                        required>
                                    <span class="error" id="categoryError">Please enter your category.</span>
                                </div>

                                <div class="full-width">
                                    <label for="message">Message</label>
                                    <textarea id="message" name="Message" rows="3" placeholder="A short message..."
                                        required></textarea>
                                    <span class="error" id="messageError">Please enter a message.</span>
                                </div>

                                <div class="full-width actions">
                                    <button type="submit">JOIN THE NETWORK</button>
                                </div>
                            </div>
                        </form>
                    </div>

                    <script>
                        (function () {
                            var form = document.getElementById('signupForm');
                            if (!form) return;
                            form.addEventListener('submit', function (event) {
                                var isValid = true;
                                function showError(id, condition) {
                                    var error = document.getElementById(id);
                                    if (!error) return;
                                    if (condition) { error.style.display = 'block'; isValid = false; } else { error.style.display = 'none'; }
                                }

                                var fullName = document.getElementById('fullName').value.trim();
                                var email = document.getElementById('email').value.trim();
                                var phone = document.getElementById('phone').value.trim();
                                var gender = document.getElementById('gender').value;
                                var platform = document.getElementById('platform').value;
                                var profile = document.getElementById('profile').value.trim();
                                var followers = document.getElementById('followers').value;
                                var state = document.getElementById('state').value.trim();
                                var category = document.getElementById('category').value.trim();
                                var message = document.getElementById('message').value.trim();

                                showError('nameError', fullName === '');
                                showError('emailError', !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email));
                                showError('phoneError', !/^[0-9]{10,15}$/.test(phone));
                                showError('genderError', gender === '');
                                showError('platformError', platform === '');
                                showError('profileError', !profile.startsWith('http'));
                                showError('followersError', Number(followers) < 1);
                                showError('stateError', state === '');
                                showError('categoryError', category === '');
                                showError('messageError', message === '');

                                if (!isValid) { event.preventDefault(); window.scrollTo({ top: 0, behavior: 'smooth' }); }
                            });
                        })();
                    </script>
                </div>
            </div>
        </div>
    </section>

