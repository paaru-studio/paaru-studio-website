    <!-- Benefits Section -->
    <section class="services-detail process-section im-benefits">
        <div class="container">
            <div class="section-header">
                <h2>Benefits of Our Influencer Marketing Services</h2>
                <div class="underline"></div>
            </div>
            <div class="steps-container">
                <div class="step-item step-gradient-1">
                    <div class="step-content">
                        <div class="step-number">01</div>
                        <h3>Authentic Brand Storytelling</h3>
                        <p>Influencers speak the language of their communities. By leveraging our network, you gain
                            access to trusted voices that turn brand messages into relatable stories, boosting
                            credibility and shareability.</p>
                    </div>
                </div>
                <div class="step-item step-gradient-2">
                    <div class="step-content">
                        <div class="step-number">02</div>
                        <h3>Rapid Reach & Growth</h3>
                        <p>One high-impact post can earn more impressions than months of organic effort. Strategic
                            influencer marketing spikes brand awareness, follower growth, and engagement metrics in
                            days, not quarters.</p>
                    </div>
                </div>
                <div class="step-item step-gradient-3">
                    <div class="step-content">
                        <div class="step-number">03</div>
                        <h3>Full-Funnel Impact</h3>
                        <p>Influencer content drives both discovery and direct sales with precision tracking links,
                            promo codes, and platform-native shopping tools. Our funnels turn virality into conversions.
                        </p>
                    </div>
                </div>
                <div class="step-item step-gradient-4">
                    <div class="step-content">
                        <div class="step-number">04</div>
                        <h3>Cost-Effective Assets</h3>
                        <p>Content created by influencers outlasts the campaign period. Repurpose influencer reels,
                            shorts, and carousels across ads, email, and platforms to drive maximum lifetime ROI.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

