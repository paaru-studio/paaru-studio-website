# Global Security & Caching Headers for Netlify CDN
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin

# Immutable HTTP Caching for WebP & PNG Images (1 Year Cache)
/*.webp
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.jpg
  Cache-Control: public, max-age=31536000, immutable

# Immutable HTTP Caching for Fonts & Static Stylesheets
/*.woff2
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

# Immutable HTTP Caching for JavaScript Bundles
/*.js
  Cache-Control: public, max-age=31536000, immutable
